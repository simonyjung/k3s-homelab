{
  "extends": [
    ":dependencyDashboard",
    ":semanticPrefixFixDepsChoreOthers",
    ":ignoreModulesAndTests",
    "group:monorepos",
    "helpers:pinGitHubActionDigests",
    "group:recommended",
    "mergeConfidence:age-confidence-badges",
    "replacements:all",
    "workarounds:all"
  ],
  "hostRules": [
    {
      "description": "Private merge-bot chart (apps-helm/merge-bot); read_registry deploy token, secret set in the Mend portal",
      "matchHost": "registry.gitlab.com",
      "hostType": "docker",
      "username": "gitlab+deploy-token-16596833",
      "password": "{{ secrets.GITLAB_REGISTRY_TOKEN }}"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^apps/.*/.*\\.yaml$/",
        "/^apps-helm/[^/]+/templates/cloudflared\\.yaml$/",
        "/^infrastructure/system-upgrade/system-upgrade-controller\\.yaml$/",
        "/^infrastructure/kube-vip/daemonset\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "autoReplaceStringTemplate": "image: {{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/system-upgrade/system-upgrade-controller\\.yaml$/"
      ],
      "matchStrings": [
        "SYSTEM_UPGRADE_JOB_KUBECTL_IMAGE: (?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "autoReplaceStringTemplate": "SYSTEM_UPGRADE_JOB_KUBECTL_IMAGE: {{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/system-upgrade/plans\\.yaml$/"
      ],
      "matchStrings": [
        "version: (?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Pin images as tag@sha256 so a registry-side re-push of a tag can't reach the cluster without a PR (plan 12.7a)",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "dinglink tags are CI-built sha-* images, out of scope for digest pinning",
      "matchPackageNames": ["/^ghcr\\.io/simonyjung/dinglink-/"],
      "pinDigests": false
    },
    {
      "description": "Batch same-tag digest refreshes into one weekly PR (the initial pins already arrive as one 'Pin dependencies' PR)",
      "matchUpdateTypes": ["digest"],
      "groupName": "image digests",
      "schedule": ["before 6am on monday"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/transmission"],
      "versioning": "semver",
      "allowedVersions": "<8"
    },
    {
      "description": "k8s control planes cannot skip minors: one PR per minor hop, in order",
      "matchDepNames": ["k3s-io/k3s"],
      "separateMultipleMinor": true,
      "commitMessageTopic": "k3s"
    },
    {
      "description": "SUC manifests are vendored: the PR is a notification, re-vendor before merging",
      "matchPackageNames": ["rancher/system-upgrade-controller"],
      "prBodyNotes": ["⚠️ **Vendored manifests** — do not merge the tag bump alone. Re-download `crd.yaml` + `system-upgrade-controller.yaml` from the upstream release into `infrastructure/system-upgrade/` (see docs/upgrades.md, 'Upgrading the controller itself')."]
    }
  ]
}
